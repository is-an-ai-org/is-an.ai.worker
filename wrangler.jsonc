{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "is-an-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-16",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "is-an-ai-db-prod",
      "database_id": "77e900cd-2752-4198-82ed-6f87af630219",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_STORE",
      "id": "71de94e55ca94b5486c7a6d71986c45a",
    },
  ],

  "r2_buckets": [
    {
      "binding": "SITES_BUCKET",
      "bucket_name": "is-an-ai-sites"
    }
  ],

  // 🔴 실제 트래픽을 받는 것은 이 최상위 설정으로 배포되는 `is-an-ai-worker` 다.
  // `--env production` 은 이름이 다른 별도 워커(`is-an-ai-worker-production`)를 만들고,
  // api.is-an.ai 앞의 AWS API Gateway 는 그쪽을 보지 않는다. 2026-09-05 에
  // 그것 때문에 배포해도 반영이 안 되는 상태를 겪었다.
  //
  // 그래서 운영 값은 여기에 있어야 한다. 비어 있으면 GITHUB_CLIENT_ID 가 undefined 가 되어
  // 로그인 리다이렉트에 client_id 가 빠지고 인증이 통째로 깨진다.
  "vars": {
    "ENV_TYPE": "prod",
    // --- org 이전 스위치 -------------------------------------------
    // GitHub App을 새로 만들면 GITHUB_BOT_EMAIL의 숫자(앱 봇 계정 ID)가 바뀐다.
    "GITHUB_OWNER": "is-an-ai-org",
    "GITHUB_REPO": "is-an.ai",
    "GITHUB_BOT_NAME": "is-an-ai-org-bot[bot]",
    "GITHUB_BOT_EMAIL": "323575661+is-an-ai-org-bot[bot]@users.noreply.github.com",
    "APP_URL": "https://api.is-an.ai",
    "JWT_EXPIRES_IN": "120h",
    "FRONTEND_URL": "https://is-an.ai",
    "GITHUB_REDIRECT_URI": "https://api.is-an.ai/v1/user/auth/github/callback",
  },
  "env": {
    "production": {
      "vars": {
        "ENV_TYPE": "prod",
        // --- org 이전 스위치 -------------------------------------------
        // 새 org로 넘어가는 날 이 네 값만 바꾸고 배포한다. 코드는 안 건드린다.
        // GitHub App을 새로 만들면 GITHUB_BOT_EMAIL의 숫자(앱 봇 계정 ID)가 바뀐다.
        "GITHUB_OWNER": "is-an-ai-org",
        "GITHUB_REPO": "is-an.ai",
        "GITHUB_BOT_NAME": "is-an-ai-org-bot[bot]",
        "GITHUB_BOT_EMAIL": "323575661+is-an-ai-org-bot[bot]@users.noreply.github.com",
        "APP_URL": "https://api.is-an.ai",
        // "JWT_SECRET": "IS_IN_PROD_SECRET",
        "JWT_EXPIRES_IN": "120h",
        "FRONTEND_URL": "https://is-an.ai",
        "GITHUB_REDIRECT_URI": "https://api.is-an.ai/v1/user/auth/github/callback",
        // "GITHUB_CLIENT_ID": "IS_IN_PROD_SECRET",
        // "GITHUB_CLIENT_SECRET": "IS_IN_PROD_SECRET"
        // "GITHUB_PAT_TOKEN": "IS_IN_PROD_SECRET"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "is-an-ai-db-prod",
          "database_id": "77e900cd-2752-4198-82ed-6f87af630219",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_STORE",
          "id": "71de94e55ca94b5486c7a6d71986c45a",
        },
      ],
      "r2_buckets": [
        {
          "binding": "SITES_BUCKET",
          "bucket_name": "is-an-ai-sites"
        }
      ],
    },
    "development": {
      "vars": {
        "ENV_TYPE": "dev",
        // --- org 이전 스위치 -------------------------------------------
        // 새 org로 넘어가는 날 이 네 값만 바꾸고 배포한다. 코드는 안 건드린다.
        // GitHub App을 새로 만들면 GITHUB_BOT_EMAIL의 숫자(앱 봇 계정 ID)가 바뀐다.
        "GITHUB_OWNER": "is-an-ai-org",
        "GITHUB_REPO": "is-an.ai",
        "GITHUB_BOT_NAME": "is-an-ai-org-bot[bot]",
        "GITHUB_BOT_EMAIL": "323575661+is-an-ai-org-bot[bot]@users.noreply.github.com",
        "APP_URL": "http://localhost:8787",
        "JWT_SECRET": "IT_IS_DEV_SECRET",
        "JWT_EXPIRES_IN": "120h",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "is-an-ai-db-prod",
          "database_id": "77e900cd-2752-4198-82ed-6f87af630219",
          "migrations_dir": "drizzle/migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_STORE",
          "id": "71de94e55ca94b5486c7a6d71986c45a",
        },
      ],
      "r2_buckets": [
        {
          "binding": "SITES_BUCKET",
          "bucket_name": "is-an-ai-sites"
        }
      ],
    },
  },

  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
